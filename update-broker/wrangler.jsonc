{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fsm-faq-update-broker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "updates.furiositymarketing.com",
      "custom_domain": true
    },
    {
      // Legacy hostname: FSM FAQ <= 1.1.9 has it hard-coded. Keep until all sites run 1.1.10+.
      "pattern": "updates.fullspectrummarketing.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://updates.furiositymarketing.com"
  },
  "kv_namespaces": [
    {
      "binding": "STORE",
      // Furiosity Cloudflare account namespace "fsm-faq-update-broker" (created via Cloudflare MCP)
      "id": "b40e905330c047dd920002daa7c411f8"
    }
  ]
}
